# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embedding & Vector Store Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Upload & Security Limits
MAX_UPLOAD_SIZE_MB=15

# FastAPI Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Database Configuration
DATABASE_URL=sqlite:///./storage/legalease.db

# Authentication, Session & Multi-Tenant Security
# In production, ENVIRONMENT must be set to "production" and JWT_SECRET_KEY must be >= 32 cryptographically secure bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development
COOKIE_SECURE=false
JWT_SECRET_KEY=legalease-production-jwt-secret-key-change-in-env-32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# One-time Administrator Bootstrap Secret
# Required only once to initialize the initial system administrator via POST /api/auth/bootstrap-admin.
# In production: must be non-empty and at least 16 characters. Server startup will fail without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_BOOTSTRAP_SECRET=your_secure_admin_bootstrap_secret_here

# CORS Allowed Origins (comma-separated)
# Defaults to localhost Streamlit origins. Extend for custom deployments.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Redis Rate Limiter (optional — in-memory fallback used when not set)
# For single-instance dev: leave empty. For multi-instance production: set to your Redis URL.
# Example: redis://localhost:6379/0  or  redis://:password@redis-host:6379/0
REDIS_URL=
